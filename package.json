{
   "name": "@silver886/TypeScript",
   "version": "0.0.0",
   "description": "TypeScript template",
   "type": "module",
   "main": "./dist/index.js",
   "types": "./dist/index.d.ts",
   "scripts": {
      "comments": "leasot --ignore .git/**,node_modules/** --tags NOTE OPTIMIZE TODO HACK XXX FIXME BUG --filetype .ts **",
      "format": "prettier --write . && eslint --fix .",
      "format-check": "prettier --check . && eslint .",
      "watch-test": "npm run test -- --watchAll",
      "test": "jest --coverage",
      "predev-start": "npm run tsoa-gen",
      "dev-start": "env NODE_ENV=local tsx src/index.ts",
      "start": "node dist/index.js",
      "prebuild": "npm run tsoa-gen",
      "build": "tsc",
      "prebundle": "npm run tsoa-gen",
      "bundle": "tsc --noEmit && tsx esbuild.config.ts",
      "prepublish": "npm run build",
      "prepublishOnly": "npm run test",
      "tsoa-gen": "tsoa spec-and-routes"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/silver886/TypeScript.git"
   },
   "keywords": [],
   "author": {
      "name": "L",
      "email": "11664880+silver886@users.noreply.github.com"
   },
   "license": "MIT",
   "bugs": {
      "url": "https://github.com/silver886/TypeScript/issues"
   },
   "homepage": "https://github.com/silver886/TypeScript#readme",
   "devDependencies": {
      "@silver886/eslint-config": "^3.0.5",
      "@tsoa/cli": "^6.6.0",
      "@types/body-parser": "^1.19.6",
      "@types/compression": "^1.8.1",
      "@types/cookie-parser": "^1.4.10",
      "@types/cors": "^2.8.19",
      "@types/express": "^5.0.6",
      "@types/jest": "^30.0.0",
      "@types/node": "^24.10.4",
      "@types/swagger-ui-dist": "^3.30.6",
      "@types/swagger-ui-express": "^4.1.8",
      "@types/yargs": "^17.0.35",
      "esbuild": "^0.27.2",
      "eslint": "^9.39.2",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.5.4",
      "globals": "^16.5.0",
      "jest": "^30.2.0",
      "jest-junit": "^16.0.0",
      "leasot": "^14.4.0",
      "prettier": "^3.7.4",
      "prettier-plugin-multiline-arrays": "^4.1.2",
      "ts-jest": "^29.4.6",
      "tsx": "^4.21.0",
      "typescript": "^5.9.3",
      "yargs": "^18.0.0"
   },
   "dependencies": {
      "@dotenvx/dotenvx": "^1.51.2",
      "@paralleldrive/cuid2": "^3.0.4",
      "@silver886/error-context": "^0.0.4",
      "@tsoa/runtime": "^6.6.0",
      "@vendia/serverless-express": "^4.12.6",
      "body-parser": "^2.2.1",
      "compression": "^1.8.1",
      "cookie-parser": "^1.4.7",
      "cors": "^2.8.5",
      "express": "^5.2.1",
      "helmet": "^8.1.0",
      "http-status-codes": "^2.3.0",
      "swagger-ui-dist": "^5.31.0",
      "swagger-ui-express": "^5.0.1"
   }
}
